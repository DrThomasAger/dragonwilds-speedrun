  "tasks": [
    {
      "id": "rs-woodcutting-xp-5m-smoke",
      "family": "runebench-compatible",
      "env": { "kind": "rs-sdk-local", "speed_factor": 8, "xp_multiplier": 25, "start_state": "agent.sav", "network": "127.0.0.1 only" },
      "instruction": "Train Woodcutting as efficiently as possible for 5 minutes. Score is peak real-game XP/min over a 15-second window. Start with one action: await bot.skipTutorial().",
      "constraints": [
        { "id": "no-server-edits", "text": "Do not modify server files, save files, or use cheat commands.", "check": "count(violation.kind=='server-edit') == 0", "hard": true },
        { "id": "explain-actions", "text": "Every act carries a non-empty reason.", "check": "all(act.reason)", "hard": false, "w": 0.5 }
      ],
      "roles": [{ "id": "trainer", "min": 1 }],
      "handover": { "allowed": false },
      "horizon_s": 300,
      "success": { "type": "threshold", "expr": "peak_rate > 0" },
      "metrics": { "primary": "peak_rate_15s", "skill": "Woodcutting" },
      "targets": { "par": null, "target": null, "record": null, "ref_rate_source": "https://maxbittker.github.io/runebench/" },
      "sources": ["https://github.com/MaxBittker/runebench", "https://github.com/MaxBittker/rs-sdk"]
    },
    {
